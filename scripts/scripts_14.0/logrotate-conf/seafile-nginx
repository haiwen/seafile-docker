{
        su root root
        daily
        missingok
        rotate 7
        # compress
        # delaycompress
        dateext
        dateformat .%Y-%m-%d
        notifempty
        create 640
        sharedscripts
        postrotate
                SCRIPT_PID=$$
                NGINX_PID=$(pgrep -o -f "nginx: master process" | grep -v -w "$SCRIPT_PID" | head -n 1)
                if [ -n "$NGINX_PID" ]; then
                        kill -USR1 "$NGINX_PID"
                        sleep 0.2
                fi
        endscript
}
